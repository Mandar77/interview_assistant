# =============================================================================
# "FAST" TIER — fully hosted, $0, no credit card anywhere
# Location: backend/.env.fast.example
#
# Copy to `.env` (or set these as Render environment variables) and fill in the
# two keys below. Everything else already has a working default.
#
#   cp .env.fast.example .env
#
# Both keys are free and require NO credit card:
#   GEMINI_API_KEY -> https://aistudio.google.com/apikey
#   GROQ_API_KEY   -> https://console.groq.com/keys
# =============================================================================

APP_ENV=production
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# ─── Providers ───────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
STT_PROVIDER=groq
# Judge0 needs privileged Docker, which no free no-card host allows.
# Coding questions are disabled here and live on the self-hosted tier instead.
# Flip to `judge0` if you get a Piston/Judge0 endpoint.
EXEC_PROVIDER=disabled

# ─── Google AI Studio (Gemini) ───────────────────────────────────────────────
# PASTE YOUR KEY HERE ↓
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Used when the primary returns persistent 503 (shared free endpoints).
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ─── Groq (hosted Whisper STT) ───────────────────────────────────────────────
# PASTE YOUR KEY HERE ↓
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# ─── Storage ─────────────────────────────────────────────────────────────────
# Supabase free tier (no card). Leave blank to use the file-backed JSON store.
# NOTE: free Supabase projects pause after 7 days with no DB activity — keep a
# daily ping scheduled, or the app will 500 on first use after a quiet week.
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# PASTE A GENERATED SECRET HERE ↓
JWT_SECRET_KEY=

# ─── Frontend origin (for CORS + invite links) ───────────────────────────────
APP_BASE_URL=https://your-frontend.pages.dev
# Additional browser origins allowed to call this API, comma-separated.
# APP_BASE_URL is allowed automatically; add preview domains here.
# A "*" wildcard will NOT work: allow_credentials=True makes browsers
# reject it, so deployed origins must be listed explicitly.
CORS_ALLOWED_ORIGINS=

# ─── Not used on this tier ───────────────────────────────────────────────────
# Ollama and local Whisper are unused when LLM_PROVIDER=gemini / STT_PROVIDER=groq.
# Left here so the file documents the full surface.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# WHISPER_MODEL_SIZE=base

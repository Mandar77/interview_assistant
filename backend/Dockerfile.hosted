# Hosted "fast" tier image.
# Location: backend/Dockerfile.hosted
#
# Installs requirements.ci.txt, not requirements.txt — i.e. no torch, no
# openai-whisper, no ollama. That is what keeps this image small enough to cold
# start in seconds on a free host instead of ~a minute.
#
# Inference and transcription are hosted (LLM_PROVIDER=gemini, STT_PROVIDER=groq),
# so nothing here needs a GPU or a model download.
#
# Build:  docker build -f backend/Dockerfile.hosted -t interview-backend .
# Run:    docker run --env-file backend/.env.fast -p 8000:8000 interview-backend

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# ffmpeg is required by pydub for the WebM -> WAV conversion before audio is
# sent to the hosted transcriber. It is the only system dependency left once
# torch is gone.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*

# Dependencies first so the layer caches across code changes.
COPY backend/requirements.ci.txt ./requirements.ci.txt
RUN pip install --upgrade pip && pip install -r requirements.ci.txt

# spaCy model is needed by the language analyzer and JD skill parser.
RUN python -m spacy download en_core_web_sm

COPY backend/ ./

# Defaults for this tier; override per-deployment with real env vars.
ENV LLM_PROVIDER=gemini \
    STT_PROVIDER=groq \
    EXEC_PROVIDER=disabled \
    API_HOST=0.0.0.0 \
    API_PORT=8000

EXPOSE 8000

# Hosts that scale to zero route the first request in during startup, so the
# health endpoint needs to be honest about readiness.
#
# Probe the port the server is actually bound to: Render (and most PaaS) inject
# $PORT, which the CMD below honours. Probing $API_PORT instead left the
# container reporting "unhealthy" while it was serving traffic correctly.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${PORT:-8000}/api/v1/evaluation/health" || exit 1

# Render (and most PaaS) inject $PORT; fall back to 8000 locally.
CMD ["sh", "-c", "exec uvicorn app:app --host 0.0.0.0 --port ${PORT:-8000}"]

# =============================================================================
# "OWNED" TIER — self-hosted inference on your own hardware, $0, no card
# Location: backend/.env.owned.example
#
# This is the feature-complete tier: it is the one that has coding questions,
# because Judge0 runs locally in Docker.
#
#   cp .env.owned.example .env
#
# Prerequisites on the host machine:
#   ollama serve && ollama pull qwen2.5:7b
#   docker compose up -d judge0 judge0-db redis judge0-workers
#
# No API keys are required for this tier — nothing leaves your machine.
# =============================================================================

APP_ENV=production
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# ─── Providers ───────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama
STT_PROVIDER=whisper_local
EXEC_PROVIDER=judge0

# ─── Ollama (local inference) ────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# 7B is the floor. Smaller models fail schema-constrained generation and fall
# back to canned questions; a 3B model also cannot distinguish a partially
# correct answer from a wrong one.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Ollama defaults to a 2048-token context, which is too small once the job
# description is included in the prompt.
OLLAMA_NUM_CTX=8192

# ─── Whisper (local STT) ─────────────────────────────────────────────────────
WHISPER_MODEL_SIZE=base
# Set to `cuda` if you have an NVIDIA GPU — large speedup on transcription.
WHISPER_DEVICE=cpu

# ─── Judge0 (local code execution) ───────────────────────────────────────────
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_USE_HOSTED=false
JUDGE0_API_KEY=

# ─── Storage ─────────────────────────────────────────────────────────────────
# File-backed JSON store by default — fine for a single host.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# PASTE A GENERATED SECRET HERE ↓
JWT_SECRET_KEY=

# ─── Public URL ──────────────────────────────────────────────────────────────
# Your Tailscale Funnel hostname, e.g. https://yourbox.tailXXXX.ts.net
APP_BASE_URL=http://localhost:5173
# If the frontend is served from somewhere other than APP_BASE_URL
# (e.g. a Tailscale Funnel hostname), list it here.
CORS_ALLOWED_ORIGINS=

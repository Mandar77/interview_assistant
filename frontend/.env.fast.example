# "FAST" TIER — hosted frontend (Cloudflare Pages / Vercel) -> Render backend
# Location: frontend/.env.fast.example
#
# Set these as build-time environment variables in your host's dashboard.
# Vite inlines VITE_* at build time, so changing them requires a redeploy.

# NOTE: client.ts appends "/v1", so this must end in "/api" (NOT "/api/v1").
VITE_API_BASE_URL=https://your-service.onrender.com/api
# NOTE: useSpeechWebSocket appends "/api/v1/speech/stream", so this is host-only.
# Must be wss:// (not ws://) — browsers block insecure sockets from an https page.
VITE_WS_BASE_URL=wss://your-service.onrender.com

VITE_ENABLE_MEDIAPIPE=true
VITE_ENABLE_DEBUG_PANEL=false

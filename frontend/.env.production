# Production build target.
# Location: frontend/.env.production
#
# Replaced the old 3.229.160.106 EC2 address: that instance belonged to the
# now-deleted AWS account, so the build pointed at a dead host over plain http.
# Point this at whichever tier you are deploying (see .env.fast.example /
# .env.owned.example) before running `npm run build`.

VITE_API_BASE_URL=https://your-service.onrender.com/api
VITE_WS_BASE_URL=wss://your-service.onrender.com

VITE_ENABLE_MEDIAPIPE=true
VITE_ENABLE_DEBUG_PANEL=false

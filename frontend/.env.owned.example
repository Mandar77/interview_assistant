# "OWNED" TIER — self-hosted backend reached over a Tailscale Funnel
# Location: frontend/.env.owned.example
#
# Funnel gives a stable https://<host>.ts.net name, so both values use the
# same hostname. Use ws:// + http:// only when running everything on localhost.

VITE_API_BASE_URL=https://your-box.tailXXXX.ts.net/api
VITE_WS_BASE_URL=wss://your-box.tailXXXX.ts.net

VITE_ENABLE_MEDIAPIPE=true
VITE_ENABLE_DEBUG_PANEL=false
